<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core"
         xmlns:f="/lib/form">
  <f:entry title="${%VCJob.Control.Project.path.title}"
      description="${%VCJob.Control.Project.path.description}"
      help="/plugin/vectorcast-execution/help-projectPath.html">
    <f:textbox name="manageProjectName" size="50" required="true"/>
  </f:entry>
  <f:entry title="${%VCJob.JobOptions.nodeLabel.title}"
      description="${%VCJob.JobOptions.nodeLabel.description}"
      help="/plugin/vectorcast-execution/help-jobOptNodeLabel.html">
    <input name="nodeLabel" type="text"
        class="jenkins-input auto-complete" autocomplete="off"
        autocompletedelimchar=" " value="${instance.nodeLabel}"
        autocompleteurl="${autocompleteUrl}"/>
  </f:entry>
</j:jelly>
